# Generated by Neurodocker and Reproenv.

Bootstrap: docker
From: docker.io/python:3.11-slim-bookworm

%files
pyproject.toml /home/au_detection_mh/pyproject.toml
uv.lock /home/au_detection_mh/uv.lock
au_detection_mh /home/au_detection_mh/au_detection_mh
analyzes /home/au_detection_mh/analyzes
tests /home/au_detection_mh/tests
matlab /home/au_detection_mh/matlab
unreal /home/au_detection_mh/unreal
README.md /home/au_detection_mh/README.md
LICENSE /home/au_detection_mh/LICENSE

%environment
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
export ND_ENTRYPOINT="/neurodocker/startup.sh"
export DEBIAN_FRONTEND="noninteractive"
export UV_PROJECT_ENVIRONMENT="/opt/au_detection_mh"
export VIRTUAL_ENV="/opt/au_detection_mh"
export PATH="/opt/au_detection_mh/bin:$PATH"
export IS_SINGULARITY="1"
export MPLCONFIGDIR="/tmp/matplotlib"

%post
export ND_ENTRYPOINT="/neurodocker/startup.sh"
apt-get update -qq
apt-get install -y -q --no-install-recommends \
    apt-utils \
    bzip2 \
    ca-certificates \
    curl \
    locales \
    unzip
rm -rf /var/lib/apt/lists/*
sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
dpkg-reconfigure --frontend=noninteractive locales
update-locale LANG="en_US.UTF-8"
chmod 777 /opt && chmod a+s /opt
mkdir -p /neurodocker
if [ ! -f "$ND_ENTRYPOINT" ]; then
  echo '#!/usr/bin/env bash' >> "$ND_ENTRYPOINT"
  echo 'set -e' >> "$ND_ENTRYPOINT"
  echo 'export USER="${USER:=`whoami`}"' >> "$ND_ENTRYPOINT"
  echo 'if [ -n "$1" ]; then "$@"; else /usr/bin/env bash; fi' >> "$ND_ENTRYPOINT";
fi
chmod -R 777 /neurodocker && chmod a+s /neurodocker

apt-get update -qq
apt-get install -y -q --no-install-recommends \
    build-essential \
    curl \
    g++ \
    gcc \
    git \
    nano
rm -rf /var/lib/apt/lists/*

curl -LsSf https://astral.sh/uv/install.sh | sh \
                && cp /root/.local/bin/uv /root/.local/bin/uvx /usr/local/bin/

cd /home/au_detection_mh                 && UV_PROJECT_ENVIRONMENT=/opt/au_detection_mh                    uv sync --frozen --python 3.11                      --extra notebooks --no-install-project                 && rm -rf /root/.cache/uv

cd /home/au_detection_mh                 && UV_PROJECT_ENVIRONMENT=/opt/au_detection_mh                    uv sync --frozen --python 3.11 --extra notebooks                 && rm -rf /root/.cache/uv

echo 'source /opt/au_detection_mh/bin/activate'                 >> /home/au_detection_mh/.bashrc

mkdir -p /home/au_detection_mh/.jupyter                 && echo c.ServerApp.ip = \"0.0.0.0\"                 > /home/au_detection_mh/.jupyter/jupyter_lab_config.py

/opt/au_detection_mh/bin/python -m ipykernel install --sys-prefix                 --name au_detection_mh --display-name 'Python (au_detection_mh)'

chmod -R a+rX /opt/au_detection_mh

mkdir -p /home/au_detection_mh
cd /home/au_detection_mh

